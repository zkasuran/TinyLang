// =============================================================
// Example 17: Built-in Testing Framework
// =============================================================
// TinyLang has first-class test blocks! Run with:
//   node dist/cli/index.js test examples/17-testing.tiny

// --- Helper functions to test ---

fn factorial(n) {
  if n <= 1 {
    return 1
  }
  return n * factorial(n - 1)
}

fn fibonacci(n) {
  if n <= 1 {
    return n
  }
  let a = 0
  let b = 1
  for i in 2..n + 1 {
    let temp = b
    b = a + b
    a = temp
  }
  return b
}

fn isPalindrome(s) {
  let chars = [...s]
  let reversed = reverse(chars)
  return join(chars, "") == join(reversed, "")
}

fn clamp(val, lo, hi) {
  if val < lo {
    return lo
  }
  if val > hi {
    return hi
  }
  return val
}

// --- Test Blocks ---

test "factorial of 0 is 1" {
  expectToBe(factorial(0), 1)
}

test "factorial of 5 is 120" {
  expectToBe(factorial(5), 120)
}

test "factorial of 10 is 3628800" {
  expectToBe(factorial(10), 3628800)
}

test "fibonacci sequence" {
  expectToBe(fibonacci(0), 0)
  expectToBe(fibonacci(1), 1)
  expectToBe(fibonacci(5), 5)
  expectToBe(fibonacci(10), 55)
}

test "palindrome detection" {
  expectToBeTrue(isPalindrome("racecar"))
  expectToBeTrue(isPalindrome("level"))
  expectToBeFalse(isPalindrome("hello"))
  expectToBeTrue(isPalindrome("a"))
}

test "clamp keeps value in range" {
  expectToBe(clamp(5, 0, 10), 5)
  expectToBe(clamp(-5, 0, 10), 0)
  expectToBe(clamp(15, 0, 10), 10)
}

test "array operations" {
  let arr = [3, 1, 4, 1, 5, 9]
  expectToBe(len(arr), 6)

  let sorted = sort([...arr])
  expectToBe(sorted[0], 1)
  expectToBe(sorted[5], 9)
}

test "string operations" {
  expectToBe(upper("hello"), "HELLO")
  expectToBe(lower("WORLD"), "world")
  expectToBe(trim("  hi  "), "hi")
  expectToBeTrue(contains("hello world", "world"))
}

test "math functions" {
  expectToBe(abs(-42), 42)
  expectToBe(floor(3.7), 3)
  expectToBe(ceil(3.2), 4)
  expectToBe(min(5, 3), 3)
  expectToBe(max(5, 3), 5)
}

test "type checking" {
  expectToBe(type(42), "number")
  expectToBe(type("hi"), "string")
  expectToBe(type(true), "boolean")
  expectToBe(type(null), "null")
  expectToBe(type([1, 2]), "array")
}

test "error throwing works" {
  let caught = false
  try {
    throw "something went wrong"
  } catch err {
    caught = true
    expectToBe(err.message, "something went wrong")
  }
  expectToBeTrue(caught)
}
