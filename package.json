{
  "name": "tinylang",
  "version": "1.0.0",
  "description": "A complete programming language toolchain: lexer, parser, interpreter, bytecode compiler, VM, debugger, formatter, linter, test runner, and Web IDE - all in TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tinylang": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "repl": "node dist/cli/index.js repl",
    "dev": "ts-node src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "playground:build": "node playground/build.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "programming-language",
    "interpreter",
    "compiler",
    "virtual-machine",
    "bytecode",
    "debugger",
    "formatter",
    "linter",
    "educational",
    "repl",
    "tinylang",
    "learning",
    "beginner-friendly",
    "language-toolchain"
  ],
  "author": "TinyLang Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkasuran/TinyLang.git"
  },
  "homepage": "https://github.com/zkasuran/TinyLang#readme",
  "bugs": {
    "url": "https://github.com/zkasuran/TinyLang/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "wabt": "^1.0.39"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "readline-sync": "^1.4.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ]
}
